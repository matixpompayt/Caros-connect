<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/f_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="CENY PALIW · MAKS."
            android:textColor="#2FD3F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/f_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#9AA3AE"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/f_on"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
        android:layout_marginEnd="6dp"
            android:background="@drawable/widget_cell"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/f_on_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="ON"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/f_on_p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--"
                android:textColor="#EEF1F4"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/f_on_c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text=""
                android:textColor="#9AA3AE"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/f_pb95"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
        android:layout_marginEnd="6dp"
            android:background="@drawable/widget_cell"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/f_pb95_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Pb95"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/f_pb95_p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--"
                android:textColor="#EEF1F4"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/f_pb95_c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text=""
                android:textColor="#9AA3AE"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/f_pb98"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
        android:layout_marginEnd="6dp"
            android:background="@drawable/widget_cell"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/f_pb98_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Pb98"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/f_pb98_p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--"
                android:textColor="#EEF1F4"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/f_pb98_c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text=""
                android:textColor="#9AA3AE"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/f_lpg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/f_lpg_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="LPG"
                android:textColor="#A78BFA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/f_lpg_p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--"
                android:textColor="#EEF1F4"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/f_lpg_c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text=""
                android:textColor="#9AA3AE"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/f_tomorrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#C3C9D0"
        android:textSize="12sp" />
</LinearLayout>
