<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/d_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_shape" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:id="@+id/d_head" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="JAZDA" android:textColor="#2FD3F0" android:textSize="11sp" android:textStyle="bold" android:layout_weight="1" android:letterSpacing="0.1"/>

</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal">
<FrameLayout android:id="@+id/d_day" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp">
<ImageView android:id="@+id/d_day_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_cell" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
<TextView android:id="@+id/d_day_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="Dziś" android:textColor="#9AA3AE" android:textSize="11sp" android:textStyle="bold" />
<TextView android:id="@+id/d_day_v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="--" android:textColor="#EEF1F4" android:textSize="17sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/d_day_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#9AA3AE" android:textSize="11sp" android:layout_marginTop="2dp"/>
</LinearLayout>
</FrameLayout>
<FrameLayout android:id="@+id/d_week" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp">
<ImageView android:id="@+id/d_week_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_cell" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
<TextView android:id="@+id/d_week_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="Tydzień" android:textColor="#9AA3AE" android:textSize="11sp" android:textStyle="bold" />
<TextView android:id="@+id/d_week_v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="--" android:textColor="#EEF1F4" android:textSize="17sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/d_week_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#9AA3AE" android:textSize="11sp" android:layout_marginTop="2dp"/>
</LinearLayout>
</FrameLayout>
<FrameLayout android:id="@+id/d_month" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" >
<ImageView android:id="@+id/d_month_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_cell" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
<TextView android:id="@+id/d_month_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="Miesiąc" android:textColor="#9AA3AE" android:textSize="11sp" android:textStyle="bold" />
<TextView android:id="@+id/d_month_v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="--" android:textColor="#EEF1F4" android:textSize="17sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/d_month_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#9AA3AE" android:textSize="11sp" android:layout_marginTop="2dp"/>
</LinearLayout>
</FrameLayout>
</LinearLayout>
<TextView android:id="@+id/d_last" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#C3C9D0" android:textSize="12sp" android:layout_marginTop="8dp"/>
</LinearLayout>
</FrameLayout>
