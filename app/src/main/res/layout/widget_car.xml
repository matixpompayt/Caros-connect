<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_p"
            android:gravity="center"
            android:text="P"
            android:textColor="#0A0C0F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="MOJE AUTO"
            android:textColor="#2FD3F0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Brak zapisanego miejsca"
        android:textColor="#EEF1F4"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#9AA3AE"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_nav"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:text="Prowadź do auta"
        android:textColor="#0A0C0F"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
