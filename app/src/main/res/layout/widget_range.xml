<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/r_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_shape" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:id="@+id/r_head" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="ZASIĘG" android:textColor="#2FD3F0" android:textSize="11sp" android:textStyle="bold" android:layout_weight="1" android:letterSpacing="0.1"/>

</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp">
<ImageView android:id="@+id/r_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
<TextView android:id="@+id/r_km" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="--" android:textColor="#EEF1F4" android:textSize="26sp" android:textStyle="bold" />
<TextView android:id="@+id/r_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="km" android:textColor="#9AA3AE" android:textSize="11sp" />
</LinearLayout>
</FrameLayout>
<TextView android:id="@+id/r_line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#EEF1F4" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="4dp"/>
<TextView android:id="@+id/r_line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#9AA3AE" android:textSize="11sp" android:gravity="center" android:layout_marginTop="2dp"/>
</LinearLayout>
</FrameLayout>
